{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "python3 build.py --production --offline",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/rebuild",
      "schedule": "0 3 * * *"
    }
  ],
  "cleanUrls": false,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-src https://www.youtube-nocookie.com https://player.vimeo.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Speculation-Rules",
          "value": "\"/speculation-rules.json\""
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/speculation-rules.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/speculationrules+json"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/search/index.(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/editor/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/search/?q=:q",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "s",
          "value": "(?<q>.+)"
        }
      ]
    },
    {
      "source": "/it/",
      "destination": "/it/search/?q=:q",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "s",
          "value": "(?<q>.+)"
        }
      ]
    },
    {
      "source": "/fr/",
      "destination": "/fr/search/?q=:q",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "s",
          "value": "(?<q>.+)"
        }
      ]
    },
    {
      "source": "/de/",
      "destination": "/de/search/?q=:q",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "s",
          "value": "(?<q>.+)"
        }
      ]
    },
    {
      "source": "/es/",
      "destination": "/es/search/?q=:q",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "s",
          "value": "(?<q>.+)"
        }
      ]
    },
    {
      "source": "/:year(\\d{4})/",
      "destination": "/news/:year/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "post_type",
          "value": "news"
        }
      ]
    },
    {
      "source": "/:year(\\d{4})/page/:n(\\d+)/",
      "destination": "/news/:year/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "post_type",
          "value": "news"
        }
      ]
    },
    {
      "source": "/it/:year(\\d{4})/",
      "destination": "/it/notizie/:year/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "post_type",
          "value": "news"
        }
      ]
    },
    {
      "source": "/it/:year(\\d{4})/page/:n(\\d+)/",
      "destination": "/it/notizie/:year/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "post_type",
          "value": "news"
        }
      ]
    },
    {
      "source": "/fr/:year(\\d{4})/",
      "destination": "/fr/actualites/:year/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "post_type",
          "value": "news"
        }
      ]
    },
    {
      "source": "/fr/:year(\\d{4})/page/:n(\\d+)/",
      "destination": "/fr/actualites/:year/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "post_type",
          "value": "news"
        }
      ]
    },
    {
      "source": "/de/:year(\\d{4})/",
      "destination": "/de/nachrichten/:year/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "post_type",
          "value": "news"
        }
      ]
    },
    {
      "source": "/de/:year(\\d{4})/page/:n(\\d+)/",
      "destination": "/de/nachrichten/:year/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "post_type",
          "value": "news"
        }
      ]
    },
    {
      "source": "/es/:year(\\d{4})/",
      "destination": "/es/noticias/:year/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "post_type",
          "value": "news"
        }
      ]
    },
    {
      "source": "/es/:year(\\d{4})/page/:n(\\d+)/",
      "destination": "/es/noticias/:year/",
      "permanent": true,
      "has": [
        {
          "type": "query",
          "key": "post_type",
          "value": "news"
        }
      ]
    },
    {
      "source": "/feed/",
      "destination": "/feed.xml",
      "permanent": true
    },
    {
      "source": "/it/feed/",
      "destination": "/it/feed.xml",
      "permanent": true
    },
    {
      "source": "/fr/feed/",
      "destination": "/fr/feed.xml",
      "permanent": true
    },
    {
      "source": "/de/feed/",
      "destination": "/de/feed.xml",
      "permanent": true
    },
    {
      "source": "/es/feed/",
      "destination": "/es/feed.xml",
      "permanent": true
    },
    {
      "source": "/news/feed/",
      "destination": "/feed.xml",
      "permanent": true
    },
    {
      "source": "/it/notizie/feed/",
      "destination": "/it/feed.xml",
      "permanent": true
    },
    {
      "source": "/fr/actualites/feed/",
      "destination": "/fr/feed.xml",
      "permanent": true
    },
    {
      "source": "/de/nachrichten/feed/",
      "destination": "/de/feed.xml",
      "permanent": true
    },
    {
      "source": "/es/noticias/feed/",
      "destination": "/es/feed.xml",
      "permanent": true
    },
    {
      "source": "/press-releases/",
      "destination": "/press-publications/press-releases/",
      "permanent": true
    },
    {
      "source": "/it/comunicati-stampa/",
      "destination": "/it/media-e-pubblicazioni/comunicati-stampa/",
      "permanent": true
    },
    {
      "source": "/fr/communiques-de-presse/",
      "destination": "/fr/press-et-publications/communiques-de-presse/",
      "permanent": true
    },
    {
      "source": "/de/pressemitteilungen/",
      "destination": "/de/presse-und-veroeffentlichungen/pressemitteilungen/",
      "permanent": true
    },
    {
      "source": "/es/comunicados-de-prensa/",
      "destination": "/es/prensa-y-publicaciones/comunicados-de-prensa/",
      "permanent": true
    },
    {
      "source": "/news-tags/:path*",
      "destination": "/news/",
      "permanent": true
    },
    {
      "source": "/it/tag-notizia/:path*",
      "destination": "/it/notizie/",
      "permanent": true
    },
    {
      "source": "/fr/etiquettes-de-actualite/:path*",
      "destination": "/fr/actualites/",
      "permanent": true
    },
    {
      "source": "/de/nachrichten-tag/:path*",
      "destination": "/de/nachrichten/",
      "permanent": true
    },
    {
      "source": "/es/etiquetas-de-las-noticias/:path*",
      "destination": "/es/noticias/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/(.+)",
      "destination": "/api/auth?__p=$1"
    }
  ]
}
